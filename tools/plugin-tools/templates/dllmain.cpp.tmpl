    }

    PLUGIN_API wchar_t* __stdcall PluginVersion()
    {
        return ExportString(L"1.0.0");
    }

    PLUGIN_API wchar_t* __stdcall PluginIcon()
    {
        return ExportString(L"");
    }

    PLUGIN_API bool __stdcall IsApplicationSupported(int id)
    {
        switch (id)
        {
{{APP_CASES}}
            return true;
        default:
            break;
        }

        return false;
    }

    PLUGIN_API int __stdcall GetEffectsCount()
    {
        return 1;
    }

    PLUGIN_API wchar_t* __stdcall GetEffectName(int)
    {
        return ExportString(L"{{EFFECT_NAME}}");
    }

    // Hosts in the field do not consume the parameter schema yet, so this
    // matches the other shipped effects and returns nothing. ApplyEffect below
    // still reads positional parameters when a host does supply them.
    PLUGIN_API wchar_t* __stdcall GetEffectParams(int)
    {
        return NULL;
    }

    PLUGIN_API HRESULT __stdcall ApplyEffect(BYTE* pPixels, int w, int h, double dCompleteness,
                                             int nParamCount, const BSTR* sParams, void** pEffectData)
    {
        if (!pPixels || w <= 0 || h <= 0)
            return E_INVALIDARG;

        CEffectState* state = NULL;

        if (pEffectData)
        {
            if (*pEffectData == NULL)
            {
                state = new (std::nothrow) CEffectState();
                if (!state)
                    return E_OUTOFMEMORY;

                *pEffectData = state;
            }
            else
            {
                state = (CEffectState*)(*pEffectData);
            }
        }

        // A host that does not keep state still gets a usable still frame.
        CEffectState fallback;
        if (!state)
            state = &fallback;

        state->clock.Tick(dCompleteness);
        const float time = (float)state->clock.Time();

        EffectParams params;
        params.intensity = Clampf(ParamFloat(nParamCount, sParams, 0, params.intensity), 0.0f, 2.0f);
        params.speed = Clampf(ParamFloat(nParamCount, sParams, 1, params.speed), 0.05f, 5.0f);
        params.density = Clampf(ParamFloat(nParamCount, sParams, 2, params.density), 0.1f, 3.0f);

        const CSurface surface(pPixels, w, h);
        Draw(surface, params, time);

        return S_OK;
    }

    PLUGIN_API void __stdcall ReleaseEffectData(void* data)
    {
        if (NULL == data)
            return;

        delete (CEffectState*)data;
    }
}

BOOL APIENTRY DllMain(HMODULE hModule,
                      DWORD  ul_reason_for_call,
                      LPVOID lpReserved)
{
    UNREFERENCED_PARAMETER(hModule);
    UNREFERENCED_PARAMETER(lpReserved);

    switch (ul_reason_for_call)
    {
    case DLL_PROCESS_ATTACH:
    case DLL_THREAD_ATTACH:
    case DLL_THREAD_DETACH:
    case DLL_PROCESS_DETACH:
        break;
    }

    return TRUE;
}
