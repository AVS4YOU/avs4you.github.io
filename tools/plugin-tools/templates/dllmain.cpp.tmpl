// dllmain.cpp : Defines the entry point for the DLL application.
//
// {{NAME}} - {{DESC}}
//
// The animation below is a closed-form function of NSEffect::CClock time, so
// every particle keeps its identity from frame to frame instead of being
// re-randomised each call. See docs/EffectPlugin-Recipes.md before changing
// how motion is computed.

#define PLUGIN_EXPORTS

#define WIN32_LEAN_AND_MEAN // Exclude rarely-used stuff from Windows headers
// Windows Header Files
#include <windows.h>
#include "../../sdk/include/CEffectPluginIntf.h"
#include "../../sdk/include/AVSConsts.h"
#include "../../sdk/effects/effect_common.h"

#include <cmath>
#include <new>

using namespace NSEffect;

// ---------------------------------------------------------------------------
// Tuning
// ---------------------------------------------------------------------------

namespace
{
    // Author against a 1280x720 reference frame, then scale: counts by area,
    // sizes by height. A 320x180 preview then looks like a downscaled 1080p
    // render instead of a different effect.
    const float REF_W = 1280.0f;
    const float REF_H = 720.0f;

    // TODO: number of particles on a reference frame at intensity 1.0.
    const float PARTICLES_REFERENCE = 900.0f;

    struct EffectParams
    {
        float intensity;  // overall strength, 0..2
        float speed;      // motion speed multiplier
        float density;    // multiplier on the particle budget

        EffectParams()
            : intensity(1.0f), speed(1.0f), density(1.0f)
        {
        }
    };

    // Per-instance state handed back to us through **effectData. Keep it small:
    // it exists to carry the clock, not to accumulate positions.
    class CEffectState
    {
    public:
        CClock clock;
    };
}

// ---------------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------------

namespace
{
    void Draw(const CSurface& s, const EffectParams& p, float time)
    {
        const float fw = (float)s.Width();
        const float fh = (float)s.Height();

        const float sizeScale = fh / REF_H;
        const float areaScale = (fw * fh) / (REF_W * REF_H);

        const int count = (int)(PARTICLES_REFERENCE * areaScale * p.density
                                * Clampf(p.intensity, 0.0f, 2.0f) + 0.5f);

        for (int i = 0; i < count; ++i)
        {
            // Fixed identity of this particle. Same seed every frame, so its
            // lane, phase and speed never change - only `time` moves.
            const unsigned int seed = HashU32(0x9e3779b9U + (unsigned int)i * 0x9e3779b9U);

            const float lane = Rand01(seed);
            const float phase0 = Rand01(seed ^ 0xa1b2c3d4U);
            const float ownSpeed = p.speed * RandRange(seed ^ 0x1f83d9abU, 0.8f, 1.25f);
            const float radius = RandRange(seed ^ 0x5be0cd19U, 1.0f, 2.5f) * sizeScale;

            // TODO: replace with the motion this effect needs. The rule is that
            // position must be a pure function of `time` - never `pos += step`.
            const float cycle = 1.0f / (ownSpeed + 0.0001f);   // seconds per pass
            const float phase = Fract(phase0 + time / cycle);

            const float x = lane * fw;
            const float y = phase * fh;

            s.SplatBlend(x, y, (radius < 0.5f) ? 0.5f : radius,
                         250.0f, 250.0f, 250.0f, 0.35f);
        }
    }
}

